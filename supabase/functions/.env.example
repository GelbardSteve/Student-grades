# Copy to supabase/functions/.env for local development (gitignored).
# In production set these with: npx supabase secrets set --env-file supabase/functions/.env
# Never put any of these in the React app.

# Brevo (https://www.brevo.com): Settings -> SMTP & API -> API keys
BREVO_API_KEY=
# A sender address verified in Brevo (Senders -> Add a sender). Works without owning a domain.
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=Grades

# The React app's address(es) for CORS, comma-separated
ALLOWED_ORIGIN=http://localhost:3000
MAX_EMAILS_PER_HOUR=30

# Local tests only: point at a mock provider instead of Brevo
# BREVO_API_URL=http://host.docker.internal:4010
